<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiscordAdminTool.Views.RolesPopupWindow"
        Width="420" CanResize="False" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Background="#1A1D26"
        Title="Gestionar Roles">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="White" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="AddTab" Content="Agregar" Classes="tab-item active" Click="AddTabClick" />
            <Button x:Name="RemoveTab" Content="Quitar" Classes="tab-item" Click="RemoveTabClick" />
        </StackPanel>
        <ScrollViewer MaxHeight="280">
            <ItemsControl x:Name="RolesList" />
        </ScrollViewer>
        <Grid ColumnDefinitions="*,10,*" Margin="0,4,0,0">
            <Button Grid.Column="0" Content="Cancelar" Classes="btn-ghost" HorizontalContentAlignment="Center" Click="CancelClick" />
            <Button Grid.Column="2" x:Name="ApplyButton" Content="Aplicar" Classes="btn-primary" HorizontalContentAlignment="Center" Click="ApplyClick" />
        </Grid>
    </StackPanel>
</Window>
