<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiscordAdminTool.Views.ProgressPopupWindow"
        Width="380" CanResize="False" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Background="#1A1D26"
        Title="Procesando">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="White" />
        <TextBlock x:Name="BodyText" FontSize="13" Foreground="#B5BAC1" TextWrapping="Wrap" />
        <TextBlock Text="Esto puede tardar si el canal tiene muchos mensajes." FontSize="11" Foreground="#8E9297" TextWrapping="Wrap" />
        <Button x:Name="CancelButton" Content="Cancelar" Classes="btn-danger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="CancelClick" />
    </StackPanel>
</Window>
