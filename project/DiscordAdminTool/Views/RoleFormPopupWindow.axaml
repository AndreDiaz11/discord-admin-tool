<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiscordAdminTool.Views.RoleFormPopupWindow"
        Width="380" CanResize="False" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Background="#1A1D26"
        Title="Rol">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="White" />
        <StackPanel Spacing="6">
            <TextBlock Text="Nombre del rol" Classes="field-label" />
            <TextBox x:Name="NameBox" Watermark="Nombre" />
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Text="Color (hex)" Classes="field-label" />
            <TextBox x:Name="ColorBox" Watermark="#5865F2" />
        </StackPanel>
        <CheckBox x:Name="HoistCheck" Content="Mostrar por separado en la lista de miembros" Foreground="#F2F3F5" />
        <CheckBox x:Name="MentionableCheck" Content="Mencionable" Foreground="#F2F3F5" />
        <Grid ColumnDefinitions="*,10,*" Margin="0,4,0,0">
            <Button Grid.Column="0" Content="Cancelar" Classes="btn-ghost" HorizontalContentAlignment="Center" Click="CancelClick" />
            <Button Grid.Column="2" Content="Guardar" Classes="btn-primary" HorizontalContentAlignment="Center" Click="SaveClick" />
        </Grid>
    </StackPanel>
</Window>
